+def draw_tax(points: int) -> int:
+    return max(0, points - DRAW_TAX_THRESHOLD) // DRAW_TAX_BAND
+
+
+def draw_cost(points: int) -> int:
+    return 1 + draw_tax(points)
+
+
+def rarity_distribution_at(elapsed_minutes: int) -> list[tuple[int, float]]:
+    step = min(
+        max(0, elapsed_minutes // RARITY_BOOST_INTERVAL_MINUTES),
+        RARITY_BOOST_PEAK_HOUR,
+    )
+    rare_rate = min(100.0, RARITY_INITIAL_RATE + step * RARITY_BOOST_PER_STEP)
+    rare_scale = rare_rate / RARITY_INITIAL_RATE
+    return [
+        (1, 100.0 - rare_rate),
+        *((rarity, weight * rare_scale) for rarity, weight in RARITY_DISTRIBUTION if rarity >= 2),
+    ]
+
+
