{
  "version": 1,
  "sourceRowCount": 81,
  "rules": [
    {
      "sourceId": "0c4943ad6b093",
      "stageId": 213,
      "ruleName": "2ピック",
      "body": "①ピクミン投げ、②Bボタン、③隊列誘導＆解散、④スプレー。の4つのうち、2つを禁止してプレイしてください。",
      "creatorUserId": "albut3",
      "createdAt": "2023-12-05T07:35:33.000Z",
      "updatedAt": "2023-12-05T09:32:22.000Z"
    },
    {
      "sourceId": "1857d771ead8d",
      "stageId": 208,
      "ruleName": "チキンレース",
      "body": "このルールでは、原生生物に一度でもダメージを与えた後は、ピクミンの犠牲を出してはいけません。そして、全回収（1840ポコ）して脱出成功した記録のみ有効となり、その際のスコアは 50 - (残りピクミン数) となります。\n\n　\n\n（投稿理由：最初に目標を自分で設定して挑戦するタイプの縛りは新しいと思う　ステージを問わず成立する汎用的な縛りなので、違うステージでやってみるのも面白そうですね）",
      "creatorUserId": "muratsubo",
      "createdAt": "2023-12-05T10:38:43.000Z",
      "updatedAt": "2023-12-07T15:41:28.000Z"
    },
    {
      "sourceId": "1b61a45e97ff0",
      "stageId": 208,
      "ruleName": "残スプレーコンテスト",
      "body": "ゲキカラ1つにつき20点、ゲキニガ1つにつき20点のボーナスが加算される。",
      "creatorUserId": "Argent2home",
      "createdAt": "2023-12-05T08:29:28.000Z",
      "updatedAt": "2023-12-05T08:29:28.000Z"
    },
    {
      "sourceId": "23b79623f84e8",
      "stageId": 401,
      "ruleName": "Aボタン縛り",
      "body": "Aボタンのみを使わない縛りです。それ以外はok",
      "creatorUserId": "shino15nome",
      "createdAt": "2023-12-05T09:01:30.000Z",
      "updatedAt": "2023-12-05T09:01:30.000Z"
    },
    {
      "sourceId": "2ce1a5ae86639",
      "stageId": 428,
      "ruleName": "オッチン禁止",
      "body": "この縛りでは、オッチンを初期位置から動かしてはいけません。ソウビの制限はありません。",
      "creatorUserId": "Bl6AltMzq5Jx4aM",
      "createdAt": "2023-12-12T09:22:13.000Z",
      "updatedAt": "2023-12-12T09:22:13.000Z"
    },
    {
      "sourceId": "307c05d7481b3",
      "stageId": 209,
      "ruleName": "70秒",
      "body": "「タイムボーナス」が111以上である記録のみ有効です。",
      "creatorUserId": "albut3",
      "createdAt": "2023-12-05T08:37:51.000Z",
      "updatedAt": "2023-12-05T08:37:51.000Z"
    },
    {
      "sourceId": "3a0e3eb9aee4b",
      "stageId": 230,
      "ruleName": "ぱっくん縛り",
      "body": "地下5階のダイオウデメマダラのトドメは爆弾でなければならない（ピクミンでHP0にしてはいけない）",
      "creatorUserId": "Gorei_50",
      "createdAt": "2023-12-09T10:23:20.000Z",
      "updatedAt": "2023-12-09T10:23:20.000Z"
    },
    {
      "sourceId": "3c7657c990566",
      "stageId": 215,
      "ruleName": "白のみ",
      "body": "開始直後に赤ピクミンを隔離し、それ以降、赤ピクミンに仕事をさせてはいけない",
      "creatorUserId": "noamoa",
      "createdAt": "2023-12-05T13:27:57.000Z",
      "updatedAt": "2023-12-05T13:27:57.000Z"
    },
    {
      "sourceId": "4835790262145",
      "stageId": 201,
      "ruleName": "テスト",
      "body": "これはテストです。",
      "creatorUserId": "koppacha",
      "createdAt": "2023-12-05T06:10:38.000Z",
      "updatedAt": "2023-12-05T06:10:38.000Z"
    },
    {
      "sourceId": "483d8912a56a6",
      "stageId": 217,
      "ruleName": "黄色のみ",
      "body": "開始直後に全隊列を率いてエレキムシの電撃に突っ込み、黄ピクミン以外をすべて犠牲にしてからプレイを開始した記録のみ有効です。",
      "creatorUserId": "toripoppo0307",
      "createdAt": "2023-12-05T10:15:25.000Z",
      "updatedAt": "2023-12-05T10:35:37.000Z"
    },
    {
      "sourceId": "4b7bf38478e61",
      "stageId": 407,
      "ruleName": "羽尊重",
      "body": "このルールでは、オタカラ・キンカイの運搬を羽ピクミン以外（赤ピクミン・オッチン・リーダー）で行ってはいけません。原生生物との戦闘・運搬に関して縛りはありません。ソウビの使用に制限はありません。\n\n　\n\n（投稿理由：普段羽が使われずに悲しい思いをしていそうなステージにスポットライトを当てたい　羽で運搬しているものに赤が加勢してしまうことはないので、意図しないルール違反も起きにくいです）",
      "creatorUserId": "muratsubo",
      "createdAt": "2023-12-05T08:15:47.000Z",
      "updatedAt": "2023-12-07T15:39:37.000Z"
    },
    {
      "sourceId": "55ceee8d1f213",
      "stageId": 401,
      "ruleName": "ピクミン禁止",
      "body": "リーダーおよびオッチンのみで攻略します。一度でもピクミンが敵などを叩いたり、運搬物に取り付いたりした記録はすべて無効です。装備およびスキルの取得状況・装備状況は不問とします。また、全回収は必須としません。\n※隊列にピクミンが入ってしまった場合は、一切の作業ができない場所にピクミンを投げるなどして分離すればよいものとします。",
      "creatorUserId": "toripoppo0307",
      "createdAt": "2023-12-05T09:49:45.000Z",
      "updatedAt": "2023-12-05T10:33:27.000Z"
    },
    {
      "sourceId": "659fec047ff6c",
      "stageId": 201,
      "ruleName": "ボタン禁止",
      "body": "ムービーをスキップする、次のフロアへ進む、あるいは間欠泉から脱出するためのAボタンを除き、あらゆるボタン操作を禁止してプレイした記録のみ有効です。\n(Switch版のみ、隊列操作のためのLトリガーは許可されます)",
      "creatorUserId": "toripoppo0307",
      "createdAt": "2023-12-05T10:27:52.000Z",
      "updatedAt": "2023-12-05T10:27:52.000Z"
    },
    {
      "sourceId": "691c951679165",
      "stageId": 209,
      "ruleName": "葉ピク減点",
      "body": "最後に残っているピクミンのうち、葉ピクミンの数だけ最終スコアから減点(犠牲扱いに)します。なお、ミウリンによって埋められたピクミンは犠牲扱いとし、抜いてはいけません。",
      "creatorUserId": "toripoppo0307",
      "createdAt": "2023-12-05T09:47:11.000Z",
      "updatedAt": "2023-12-05T10:36:18.000Z"
    },
    {
      "sourceId": "6ca7646e165df",
      "stageId": 406,
      "ruleName": "オッチン・拠点移動禁止",
      "body": "この縛りでは、開始後すぐにオッチンを邪魔にならない場所(最初の拠点の左下など)に移動させなければならず、その後オッチンを戦闘、運搬、ギミック破壊、サブリーダーなどの役目で使用してはいけません。まだ、拠点を移してはいけません。ソウビの制限はありません。",
      "creatorUserId": "Bl6AltMzq5Jx4aM",
      "createdAt": "2023-12-05T09:05:42.000Z",
      "updatedAt": "2023-12-05T09:05:42.000Z"
    },
    {
      "sourceId": "6fd2447680966",
      "stageId": 224,
      "ruleName": "爆殺",
      "body": "敵は爆弾でトドメを刺さなければならない",
      "creatorUserId": "noamoa",
      "createdAt": "2023-12-05T13:28:21.000Z",
      "updatedAt": "2023-12-05T13:28:21.000Z"
    },
    {
      "sourceId": "70866c07cedf6",
      "stageId": 217,
      "ruleName": "虫無視",
      "body": "エレキムシとタマゴムシを倒してはいけない",
      "creatorUserId": "noamoa",
      "createdAt": "2023-12-05T13:22:38.000Z",
      "updatedAt": "2023-12-05T13:26:24.000Z"
    },
    {
      "sourceId": "75d7c787a6fe3",
      "stageId": 401,
      "ruleName": "オッチンといっしょ",
      "body": "プレイ開始時にオッチンにプレイヤーが乗りそれ以降は常にオッチンに乗った状態で操作する。途中でオッチンからプレイヤーが降りたりプレイ開始時にオッチンに乗るまでオッチンに乗る以外の操作は禁止。装備の制限は無し",
      "creatorUserId": "mikou_musicgame",
      "createdAt": "2023-12-05T11:21:21.000Z",
      "updatedAt": "2023-12-05T11:21:21.000Z"
    },
    {
      "sourceId": "76c0c09a37ef7",
      "stageId": 213,
      "ruleName": "生物後回し",
      "body": "カギを持っている敵を倒した後は、カギとその生物の死骸以外の運搬物を回収してはいけない",
      "creatorUserId": "noamoa",
      "createdAt": "2023-12-05T13:27:22.000Z",
      "updatedAt": "2023-12-05T16:54:00.000Z"
    },
    {
      "sourceId": "78b8cd8468c12",
      "stageId": 224,
      "ruleName": "オオマンマンラストキル",
      "body": "オオマンマンを倒すのは、他の全ての敵を討伐してからでなければならない。",
      "creatorUserId": "Argent2home",
      "createdAt": "2023-12-05T08:30:24.000Z",
      "updatedAt": "2023-12-06T16:13:14.000Z"
    },
    {
      "sourceId": "8d3b40c082c1c",
      "stageId": 406,
      "ruleName": "拠点移動禁止",
      "body": "このルールでは、「拠点をうつす」コマンドを実行した記録は無効となります。ソウビの使用に制限はありません。\n\n　\n\n（投稿理由：ダンドリチャレンジで（確か）唯一拠点移動が行えるステージなので、特有の縛りをつけてみたかった）",
      "creatorUserId": "muratsubo",
      "createdAt": "2023-12-05T08:08:36.000Z",
      "updatedAt": "2023-12-07T15:38:00.000Z"
    },
    {
      "sourceId": "8f923c7e22b36",
      "stageId": 425,
      "ruleName": "オッチンのみ縛り",
      "body": "オッチンだけを操作して攻略。紫ピクミンを使ってはいけない。",
      "creatorUserId": "atmy_17",
      "createdAt": "2023-12-05T09:51:10.000Z",
      "updatedAt": "2023-12-05T09:51:10.000Z"
    },
    {
      "sourceId": "94763c2c2808d",
      "stageId": 401,
      "ruleName": "近道禁止",
      "body": "このルールでは、地形ギミック（土のカベ、植木ばちの植物、ツボ、のぼりヒモ）の開通作業を行ってはいけません。\n\n　\n\n（投稿理由：初期ステージゆえルートがガチガチに煮詰まっているからこそ、普段はおよそやらないルートを構築してみてほしい）",
      "creatorUserId": "muratsubo",
      "createdAt": "2023-12-05T10:52:25.000Z",
      "updatedAt": "2023-12-07T15:38:43.000Z"
    },
    {
      "sourceId": "a0020e411e645",
      "stageId": 409,
      "ruleName": "ダンドリ検定レギュレーション",
      "body": "ダンドリ検定のルールのもと行う。",
      "creatorUserId": "atmy_17",
      "createdAt": "2023-12-05T06:34:59.000Z",
      "updatedAt": "2023-12-05T06:34:59.000Z"
    },
    {
      "sourceId": "a5e22727a16d2",
      "stageId": 410,
      "ruleName": "乗りっぱなし",
      "body": "操作開始から終了までオッチンに乗ったままプレイしなければなりません。計1秒以上プレイヤーがオッチンに乗っていない状態になっているプレイは無効となります。ソウビ及びオッチンのスキルに制限はありません。また、時間切れになってしまったプレイも有効な記録となりますが、居残り練習で出した記録は無効となります。",
      "creatorUserId": "April_lapispik",
      "createdAt": "2023-12-05T14:06:37.000Z",
      "updatedAt": "2023-12-05T14:23:36.000Z"
    },
    {
      "sourceId": "a5ebdfff0b92e",
      "stageId": 224,
      "ruleName": "クリアリング確認",
      "body": "敵をすべて倒しきるまで（最後の1匹をHP0にするまで）ポッドに運搬物を入れてはいけない",
      "creatorUserId": "Gorei_50",
      "createdAt": "2023-12-05T09:58:29.000Z",
      "updatedAt": "2023-12-05T10:06:49.000Z"
    },
    {
      "sourceId": "a65014f7ae362",
      "stageId": 217,
      "ruleName": "エレキ無視",
      "body": "エレキムシを倒さずに攻略。エレキムシにダメージが入るのはいいが、完全にHPを削りきってしまった場合は無効。",
      "creatorUserId": "Argent2home",
      "createdAt": "2023-12-05T08:23:33.000Z",
      "updatedAt": "2023-12-05T08:23:33.000Z"
    },
    {
      "sourceId": "a95e9cf08539b",
      "stageId": 208,
      "ruleName": "画面半分縛り",
      "body": "プレイ開始前にプレイ画面の右半分もしくは左側半分をタオルなどの布で隠してプレイする縛り。プレイ開始後に布で隠したり途中で布の位置を変えたりするのは禁止。また布で隠す場合は必ず画面の約半分は見えないようにする。途中リタイアのスコアは無効",
      "creatorUserId": "mikou_musicgame",
      "createdAt": "2023-12-06T03:55:49.000Z",
      "updatedAt": "2023-12-06T03:55:49.000Z"
    },
    {
      "sourceId": "ae23b104fb4be",
      "stageId": 409,
      "ruleName": "20匹縛り",
      "body": "この縛りでは、画面右下の地上ピクミン数の表示が一瞬でも21以上になった記録は無効です。オッチンスキルやソウビの制限はありません。",
      "creatorUserId": "Bl6AltMzq5Jx4aM",
      "createdAt": "2023-12-12T09:18:57.000Z",
      "updatedAt": "2023-12-12T09:18:57.000Z"
    },
    {
      "sourceId": "b18f405c294df",
      "stageId": 222,
      "ruleName": "残ピク1",
      "body": "残りピクミン1匹で脱出した記録のみ有効です。",
      "creatorUserId": "albut3",
      "createdAt": "2023-12-05T09:17:29.000Z",
      "updatedAt": "2023-12-05T09:17:29.000Z"
    },
    {
      "sourceId": "b8a12829e6adc",
      "stageId": 416,
      "ruleName": "自分+相手",
      "body": "ストーリーモードから挑戦してください。このルールでは、「自分のスコア」と「相手のスコア」の合計が最終的なスコアになります。ソウビ及びオッチンのスキルに制限はありません。自分のスコアより相手のスコアの方が上回っている場合でも有効な記録とします。",
      "creatorUserId": "April_lapispik",
      "createdAt": "2023-12-05T12:51:51.000Z",
      "updatedAt": "2023-12-05T12:51:51.000Z"
    },
    {
      "sourceId": "c5383b9511021",
      "stageId": 414,
      "ruleName": "30匹制限",
      "body": "ソウビ制限：無\nダンドリバトル：ストーリーモード\nバトル中は常に自軍のピクミン総数を30以下にしてください。途中で一度でも自軍のピクミン総数が31以上になった記録は無効です。敵軍のピクミンの数は問いません。",
      "creatorUserId": "albut3",
      "createdAt": "2023-12-05T06:48:22.000Z",
      "updatedAt": "2023-12-12T02:49:26.000Z"
    },
    {
      "sourceId": "c7483ab242b46",
      "stageId": 210,
      "ruleName": "死骸のみ",
      "body": "あのカギと死骸以外回収してはいけない",
      "creatorUserId": "Gorei_50",
      "createdAt": "2023-12-05T09:59:58.000Z",
      "updatedAt": "2023-12-05T09:59:58.000Z"
    },
    {
      "sourceId": "c93f9c092059e",
      "stageId": 425,
      "ruleName": "突進縛り",
      "body": "原生生物をオッチンの突進のみで倒す\nそれ以外の攻撃で倒してはいけない\n装備の制限は無し",
      "creatorUserId": "mikou_musicgame",
      "createdAt": "2023-12-05T11:12:06.000Z",
      "updatedAt": "2023-12-05T11:12:06.000Z"
    },
    {
      "sourceId": "cd06a8549dc3d",
      "stageId": 217,
      "ruleName": "紫禁止",
      "body": "この縛りでは、開始後すぐに紫ピクミン15匹を邪魔にならない場所(場外など)に隔離しなければならず、その後紫ピクミンを戦闘・運搬・ギミック破壊などの役目で使用してはいけません。リタイア記録は無効とします。",
      "creatorUserId": "Bl6AltMzq5Jx4aM",
      "createdAt": "2023-12-05T09:15:07.000Z",
      "updatedAt": "2023-12-05T09:15:07.000Z"
    },
    {
      "sourceId": "d62a1b610f12f",
      "stageId": 401,
      "ruleName": "笛縛り",
      "body": "ソウビ制限：無\n通常の笛、トツゲキ笛、ヒマジン笛、セイレツ笛、ホームシック笛を一度も使用せずにクリアした記録のみ有効です。",
      "creatorUserId": "albut3",
      "createdAt": "2023-12-05T06:52:17.000Z",
      "updatedAt": "2023-12-05T06:52:17.000Z"
    },
    {
      "sourceId": "dc61fdd576812",
      "stageId": 415,
      "ruleName": "ピクミン増やすの禁止",
      "body": "敵やペレットを回収してピクミンを増やしてはいけない。キンカイやフルーツの回収はOK。",
      "creatorUserId": "Argent2home",
      "createdAt": "2023-12-05T08:26:54.000Z",
      "updatedAt": "2023-12-05T08:26:54.000Z"
    },
    {
      "sourceId": "df302b0c07930",
      "stageId": 222,
      "ruleName": "エキス還元祭",
      "body": "ゲキカラ・ニガともに初期数の2倍(各4個)以上残して脱出した記録のみ有効です。",
      "creatorUserId": "toripoppo0307",
      "createdAt": "2023-12-05T10:11:01.000Z",
      "updatedAt": "2023-12-05T10:11:01.000Z"
    },
    {
      "sourceId": "e47015885e269",
      "stageId": 230,
      "ruleName": "スロースタート",
      "body": "B1で紫以外のピクミンを全滅させなければならない\nまた、紫が全滅するまでは敵・間欠炎への攻撃や運搬などをしてはいけない",
      "creatorUserId": "noamoa",
      "createdAt": "2023-12-05T13:22:38.000Z",
      "updatedAt": "2023-12-05T16:51:47.000Z"
    },
    {
      "sourceId": "e587749259399",
      "stageId": 406,
      "ruleName": "拠点固定",
      "body": "拠点を移動させたプレイは無効となります。ソウビ及びオッチンのスキルに制限はありません。また、時間切れになってしまったプレイも有効な記録となりますが、居残り練習で出した記録は無効となります。",
      "creatorUserId": "April_lapispik",
      "createdAt": "2023-12-05T14:23:02.000Z",
      "updatedAt": "2023-12-05T14:23:02.000Z"
    },
    {
      "sourceId": "ea5e77c510779",
      "stageId": 214,
      "ruleName": "ノーキル",
      "body": "敵を倒してはいけない",
      "creatorUserId": "noamoa",
      "createdAt": "2023-12-05T13:28:49.000Z",
      "updatedAt": "2023-12-05T13:28:49.000Z"
    },
    {
      "sourceId": "ee2658714837e",
      "stageId": 416,
      "ruleName": "オリマーいじめ",
