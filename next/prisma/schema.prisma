// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/users-schema

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "mysql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String               @id @default(cuid())
  name               String?
  role               String?
  image              String?
  userId             String?              @unique
  email              String?              @unique
  emailHash          String?              @unique
  emailVerified      DateTime?
  password           String?              @db.VarChar(255)
  srcUserId          String?              @db.VarChar(191)
  userCatSelect      Int?
  disablePickupVideoAutoplay Boolean      @default(false)
  accounts           Account[]
  sessions           Session[]
  date               DateTime             @default(now())
  EmsilOtp           EmailOtp[]
  PasswordResetToken PasswordResetToken[]
}

model EmailOtp {
  id        String   @id @default(cuid())
  userId    String
  emailHash String   @unique
  otpHash   String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailHash])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Log {
  id     Int      @id @default(autoincrement())
  userId String?
  page   String?
  query  String?  @db.MediumText
  ip     String?
  date   DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Each save (including soft deletion) appends a revision. Only the head has currentKey.
model LimitedIdea {
  ruleId             String   @db.VarChar(36)
  revision           Int
  currentKey         String?  @unique @db.VarChar(36)
  creatorId          String   @db.VarChar(191)
  creatorName        String   @db.VarChar(191)
  editorId           String   @db.VarChar(191)
  legacyId           String?  @db.VarChar(191)
  title              Int
  stageId            Int
  ruleName           String   @db.Text
  difficulty         Int
  registrationMethod String   @db.VarChar(5)
  body               String   @db.MediumText
  hidden             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  @@id([ruleId, revision])
  @@index([creatorId, hidden, updatedAt])
  @@index([hidden, updatedAt])
  @@index([legacyId])
  @@map("limitedIdeas")
}
